{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Town Planner",
  "version": "0.4.2",
  "identifier": "au.com.rhccity.townplanner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Town Planner",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "RHC City",
    "category": "Productivity",
    "shortDescription": "Offline AI town planner for Brisbane",
    "macOS": { "minimumSystemVersion": "11.0" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
